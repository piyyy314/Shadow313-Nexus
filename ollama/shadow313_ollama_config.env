# ============================================================
# SHADOW313 NEXUS — Ollama Environment Configuration
# Copy this to your project root as .env
# ============================================================

# ── Core Ollama Settings ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=matarmohamad313/shadow313-nexus
SHADOW313_AI_BACKEND=ollama

# ── Model Variants (swap based on task) ──────────────────────
# Fast triage (2GB RAM):
OLLAMA_MODEL_FAST=llama3.2:3b
# Deep analysis (4GB RAM):
OLLAMA_MODEL_ANALYSIS=mistral:7b
# Code review (4GB RAM):
OLLAMA_MODEL_CODE=codellama:7b
# Primary Shadow313 model:
OLLAMA_MODEL_PRIMARY=matarmohamad313/shadow313-nexus

# ── API Settings ─────────────────────────────────────────────
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3
OLLAMA_STREAM=false

# ── Shadow313 Integration ────────────────────────────────────
SHADOW313_VERSION=4.0.0
SHADOW313_WORKSPACE=/workspace
SHADOW313_LOG_LEVEL=INFO
SHADOW313_BIND_PROTOCOL=313-BIND-v2
SHADOW313_PQC_ALGORITHM=SLH-DSA-SHAKE-128f

# ── Open WebUI ───────────────────────────────────────────────
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_HOST=localhost

# ── Docker ───────────────────────────────────────────────────
DOCKER_HOST_GATEWAY=host.docker.internal
SHADOW313_API_PORT=8000