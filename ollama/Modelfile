# Top-p nucleus sampling — keeps responses focused
PARAMETER top_p 0.85

# Top-k — limits token selection pool for consistency
PARAMETER top_k 40

# Context window — 8192 tokens (~6000 words of conversation history)
# Increase to 16384 if using mistral:7b or llama3.1:8b base
PARAMETER num_ctx 8192

# Repeat penalty — prevents looping/repetition in long outputs
PARAMETER repeat_penalty 1.15

# Repeat last N tokens checked for repetition
PARAMETER repeat_last_n 128

# Number of tokens to predict (-1 = unlimited)
PARAMETER num_predict -1

# Seed — set to fixed value for reproducible outputs (useful for testing)
# PARAMETER seed 313
