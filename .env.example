# ══════════════════════════════════════════════════════════════════
# Shadow313 NEXUS v4.0.0 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ══════════════════════════════════════════════════════════════════

# ── Open WebUI ────────────────────────────────────────────────────
# Secret key for JWT signing — change this to a random 32+ char string
WEBUI_SECRET_KEY=shadow313-nexus-change-me-in-production

# ── Shadow313 API ─────────────────────────────────────────────────
# API key for Shadow313 REST API
SHADOW313_API_KEY=dev-key-change-in-production

# ── Ollama ────────────────────────────────────────────────────────
# Default model to use (must be pulled first)
OLLAMA_DEFAULT_MODEL=matarmohamad313/shadow313-nexus

# ── Optional: External API keys ───────────────────────────────────
# Only needed if using cloud AI backends (not required for local Ollama)
# OPENAI_API_KEY=sk-...
# SHADOW313_SHODAN_KEY=...
# SHADOW313_GREYNOISE_KEY=...

# ── Optional: Hetzner VPS (SHA-24) ───────────────────────────────
# HETZNER_API_TOKEN=...
# VPS_HOST=...
# VPS_USER=root