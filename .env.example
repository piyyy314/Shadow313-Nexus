# ══════════════════════════════════════════════════════════════════
# Shadow313 NEXUS v4.0.0 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ══════════════════════════════════════════════════════════════════

# ── Open WebUI ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBUI_SECRET_KEY=
WEBUI_URL=http://localhost:8080

# ── Shadow313 API ─────────────────────────────────────────────────
# API key for Shadow313 REST API; generate a separate value (minimum 32 characters):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Production startup rejects placeholder or short values.
SHADOW313_API_KEY=

# For a production backend, fail closed if no API key is configured.
SHADOW313_ENV=development
# Required only when enabling shadow313.api.middleware JWT support:
# SHADOW313_JWT_SECRET=<generate-a-strong-random-secret>

# ── AI backend ─────────────────────────────────────────────────────
# Compose defaults to local Ollama. For the Vercel AI Gateway, set backend=gateway,
# AI_GATEWAY_API_KEY, and a supported provider/model in SHADOW313_AI_MODEL.
# Set SHADOW313_AI_ENDPOINT only when using a custom OpenAI-compatible endpoint.
# The Telegram bot uses the same configured backend; the static website does not proxy AI calls.
SHADOW313_AI_BACKEND=ollama
SHADOW313_AI_ENDPOINT=http://ollama:11434
SHADOW313_AI_MODEL=matarmohamad313/shadow313-nexus
# Optional OpenAI-compatible gateway URL; defaults to Vercel AI Gateway when gateway mode is selected.
# AI_GATEWAY_ENDPOINT=https://ai-gateway.vercel.sh/v1
# Optional OpenAI-compatible provider in Open WebUI. If omitted, WebUI uses Ollama only.
# OPENWEBUI_OPENAI_API_BASE_URLS=https://ai-gateway.vercel.sh/v1
# OPENWEBUI_OPENAI_API_KEYS=your_gateway_api_key
# AI_GATEWAY_API_KEY=
OLLAMA_DEFAULT_MODEL=matarmohamad313/shadow313-nexus
OLLAMA_EXTRA_MODELS=mistral:7b nomic-embed-text:latest

# ── Optional: External API keys ───────────────────────────────────
# Only needed if using cloud AI backends (not required for local Ollama)
# OPENAI_API_KEY=sk-...
# AI_GATEWAY_API_KEY=...
# SHADOW313_SHODAN_KEY=...
# SHADOW313_GREYNOISE_KEY=...

# ── Optional: Hetzner VPS (SHA-24) ───────────────────────────────
# HETZNER_API_TOKEN=...
# VPS_HOST=...
# VPS_USER=root
# ── Telegram Alert Bot ────────────────────────────────────────────────────────
# Get token from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Get chat ID: add @userinfobot to your channel, or use /getUpdates
TELEGRAM_CHAT_ID=
# Minimum severity to forward: LOW | MEDIUM | HIGH | CRITICAL
TELEGRAM_MIN_SEVERITY=HIGH
# Seconds between event polls
TELEGRAM_POLL_INTERVAL=10
# Persisted Telegram alert cursor (default lookback on first start: 15 minutes)
TELEGRAM_INITIAL_LOOKBACK_SECONDS=900

# Optional legacy HMAC plugin loader key (generate a unique value with: openssl rand -hex 32).
# Required only when using shadow313.core.plugin_manager.PluginManager.
# SHADOW313_PLUGIN_SIGNING_KEY=
