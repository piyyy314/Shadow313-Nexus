include README.md
include CHANGELOG.md
include SECURITY.md
include LICENSE
include requirements.txt
include pyproject.toml
recursive-include shadow313 *.py
global-exclude __pycache__
global-exclude *.pyc
global-exclude *.pyo
global-exclude .DS_Store
global-exclude .env
global-exclude .env.*

# Website/archive artifacts do not belong in the Python source distribution.
prune site-dist
prune docs
prune docs-archive
prune local_bundle
prune audit-results
prune notes
prune tests
prune .github
recursive-exclude shadow313 *.pyc *.pyo
